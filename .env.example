# Copy to .env and keep private. Do not commit .env.

# local while developing. production on the public server.
APP_ENV=local

# Public address of this app, no trailing slash.
# Example: https://yourdomain.com
APP_URL=

# Set to 1 only after the domain has HTTPS.
APP_FORCE_HTTPS=0

# MySQL (optional — defaults: root / empty / lending_management)
DB_HOST=localhost
DB_NAME=lending_management
DB_USER=root
DB_PASSWORD=

# Set to 1 to run loan status sync on every request (default off; use cron instead)
LOAN_STATUS_SYNC_ON_REQUEST=0

# Automated eligibility estimate (DTI — not automatic loan approval)
LENDING_MAX_DTI=40
LENDING_MIN_LOAN=3000
LENDING_MAX_LOAN=500000
LENDING_MIN_EMPLOYMENT_MONTHS=3

# Public company details (invoices, receipts, contact page, emails)
COMPANY_NAME=RJ and RR Finance Services
COMPANY_TAGLINE=Official lending & collections documentation
COMPANY_ADDRESS=Purok San Francisco, Poblacion, Sominot, ZDS
COMPANY_PHONE=+63 9817074262
COMPANY_EMAIL=RJ&RRservices@gmail.com

# Gmail SMTP configuration.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_AUTH=true
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
SMTP_FROM_NAME=RJ and RR Finance Services
SMTP_TIMEOUT=20
